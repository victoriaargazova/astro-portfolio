---
import { getEntry, getCollection, render } from "astro:content";
import ProjectsLayout from "../../layouts/ProjectsLayout.astro";
import "../../style/projects.css";

export async function getStaticPaths() {
    const blogPosts = await getCollection("projects");
    return blogPosts.map((post) => ({
        params: { id: post.id },
    }));
}

const { id } = Astro.params;
const entry = await getEntry("projects", id);

if (!entry) {
    return Astro.redirect("/404");
}

const { Content } = await render(entry);
---

<ProjectsLayout pageTitle={entry.data.title}>
    <main class="project-page">
        <header class="project-header">
            <p class="project-meta-label">Project</p>
            <h1 class="project-title-main">{entry.data.title}</h1>

            <div class="project-meta">
                <p>
                    <span class="project-meta-key">By</span>
                    <span class="project-meta-value">{entry.data.author}</span>
                </p>
                <p>
                    <span class="project-meta-key">Published</span>
                    <span class="project-meta-value">
                        {entry.data.pubDate.toDateString()}
                    </span>
                </p>
                <p>
                    <span class="project-meta-key">Tags</span>
                    <span class="project-meta-value">
                        {entry.data.tags.join(", ")}
                    </span>
                </p>
            </div>

            {
                entry.data.description && (
                    <p class="project-description-intro">
                        {entry.data.description}
                    </p>
                )
            }
        </header>

        <article class="project-body">
            <Content />
        </article>
    </main>
</ProjectsLayout>
