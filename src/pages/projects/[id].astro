---
import { getEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import ProjectDetailLayout from "../../layouts/ProjectDetailLayout.astro";
import "../../style/project-detail.css";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
    }));
}

const { id } = Astro.params;
const entry = await getEntry("projects", id);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<ProjectDetailLayout pageTitle={entry.data.title}>
    <!-- META SLOT -->
    <Fragment slot="meta">
        <div class="meta-item">
            <span class="meta-key">By</span>
            <span class="meta-value">{entry.data.author}</span>
        </div>

        <div class="meta-item">
            <span class="meta-key">Published</span>
            <span class="meta-value">
                {entry.data.pubDate.toDateString()}
            </span>
        </div>

        {
            entry.data.tags && entry.data.tags.length > 0 && (
                <div class="meta-item">
                    <span class="meta-key">Tags</span>
                    <div class="tags-container">
                        {entry.data.tags.map((tag) => (
                            <span class="tag-pill">{tag}</span>
                        ))}
                    </div>
                </div>
            )
        }
    </Fragment>

    <!-- DESCRIPTION SLOT -->
    <Fragment slot="description">
        {
            entry.data.description && (
                <p class="project-detail-description">
                    {entry.data.description}
                </p>
            )
        }
    </Fragment>

    <!-- THUMBNAIL SLOT -->
    <Fragment slot="thumbnail">
        {
            entry.data.thumbnail && (
                <div class="project-detail-thumbnail">
                    <Image
                        src={entry.data.thumbnail}
                        alt={entry.data.thumbnailAlt ?? entry.data.title}
                        widths={[400, 700, 1000]}
                        sizes="(max-width: 700px) 100vw, (max-width: 1200px) 80vw, 700px"
                        loading="lazy"
                    />
                </div>
            )
        }
    </Fragment>

    <!-- URL SLOT -->
    <Fragment slot="url">
        {
            entry.data.url && (
                <a
                    class="project-detail-link"
                    href={entry.data.url}
                    target="_blank"
                    rel="noreferrer"
                >
                    View project
                </a>
            )
        }
    </Fragment>

    <!-- MAIN CONTENT -->
    <Content />
</ProjectDetailLayout>
