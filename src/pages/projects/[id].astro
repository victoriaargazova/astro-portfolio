---
import { getEntry, getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const blogPosts = await getCollection("projects");
    return blogPosts.map((post) => ({
        params: { id: post.id },
    }));
}

const { id } = Astro.params;
const entry = await getEntry("projects", id);

if (!entry) {
    return Astro.redirect("/404");
}

const { Content } = await render(entry);
---

<BaseLayout pageTitle={entry.data.title}>
    <p><strong>By:</strong> {entry.data.author}</p>
    <p><strong>Published:</strong> {entry.data.pubDate.toDateString()}</p>
    <p><em>{entry.data.description}</em></p>
    <p><strong>Tags:</strong> {entry.data.tags.join(", ")}</p>
    <hr />
    <article>
        <Content />
    </article>
</BaseLayout>
