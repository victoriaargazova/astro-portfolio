---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../style/home.css";
---

<BaseLayout title="Home">
    <section class="hero">
        <div class="hero-inner">
            <h1 class="hero-heading">
                <span class="first-letter">V</span>ictoria Argazova
            </h1>
            <p class="hero-sub">Digital Designer</p>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section-inner">
            <h2 class="section-title">Who is Victoria?</h2>
            <div class="section-content">
                <p class="section-text">
                    I'm a digital design student interested in bold, graphic
                    interfaces that feel more like experiences than "just
                    websites".
                </p>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section-inner">
            <h2 class="section-title">Selected Work</h2>
            <div class="section-content">
                <a href="projects/project-2" class="work-card">
                    <div class="work-card-thumb">
                        <img
                            src="images/bulbthumbnail.png"
                            alt="Rooted Bulb thumbnail"
                        />
                    </div>
                    <h3 class="work-title">Rooted Bulb</h3>
                    <p class="work-subtitle">Interactive web experience</p>
                </a>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section-inner">
            <h2 class="section-title">Let's connect</h2>
            <div class="section-content">
                <p class="section-text">
                    Want to collaborate or talk about design, interfaces or
                    weird websites?
                </p>
                <a class="primary-button" href="mailto:v.argazova@email.com">
                    Email me →
                </a>
            </div>
        </div>
    </section>
    <script>
        import { gsap } from "gsap";

        if (!import.meta.env.SSR) {
            (function () {
                const hero = document.querySelector(".hero");
                const heading = document.querySelector(".hero-heading");

                if (!hero || !heading) return;

                const firstLetterEl = heading.querySelector(".first-letter");
                if (!firstLetterEl) return;

                // 🔑 TRIM THE TEXT SO WE DON'T KEEP THE LEADING WHITESPACE
                const originalText = (heading.textContent || "").trim();
                const firstLetterText = firstLetterEl.textContent || "";

                // everything after the first letter ("ictoria Argazova")
                const restText = originalText.slice(firstLetterText.length);

                // clear heading, then re-append the original first-letter span
                heading.innerHTML = "";
                heading.appendChild(firstLetterEl);

                // create spans for the remaining characters
                restText.split("").forEach((char) => {
                    const span = document.createElement("span");
                    span.textContent = char;
                    span.classList.add("hero-char");
                    heading.appendChild(span);
                });

                // GSAP timeline
                gsap.timeline({ defaults: { ease: "power3.out" } })
                    .from(".hero", {
                        opacity: 0,
                        y: 100,
                        duration: 2,
                        scale: 0.8,
                    })
                    .from(
                        ".first-letter",
                        {
                            opacity: 0,
                            scale: 0.3,
                            rotation: 360,
                            duration: 1.5,
                        },
                        "-=1",
                    )
                    .from(
                        ".hero-char",
                        {
                            opacity: 0,
                            y: 80,
                            rotationX: -90,
                            stagger: 0.05,
                            duration: 1.5,
                        },
                        "-=1",
                    )
                    .from(
                        ".hero-sub",
                        { opacity: 0, y: 50, duration: 1.2 },
                        "-=0.8",
                    );
            })();
        }
    </script>
</BaseLayout>
