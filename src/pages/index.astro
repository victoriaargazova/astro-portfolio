---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
    <section class="hero">
        <div class="hero-welcome">Welcome</div>
        <img src="/images/victoria.png" alt="Portrait of Victoria" />
        <h1 class="hero-title">Victoria<br />Argazova</h1>

        <h2 class="hero-subtitle">Digital Designer & Developer</h2>

        <p>
            I create immersive digital experiences blending interaction,
            storytelling, and bold visual design. My work explores narrative and
            emotional impact through modern web technologies.
        </p>
    </section>

    <section>
        <h2 class="section-title">Selected Work</h2>

        <a href="/projects/project-2" class="work-card">
            <img src="/images/bulbthumbnail.png" alt="Bulb Thumbnail" />
            <div class="work-card-title">Bulb Website</div>
        </a>
    </section>

    <section class="connect">
        <h2 class="section-title">Let's Connect</h2>
        <p>
            Have an idea, collaboration, or project in mind?
            <a href="mailto:v.argazova@email.com"> Contact me → </a>
        </p>
    </section>
</BaseLayout>
