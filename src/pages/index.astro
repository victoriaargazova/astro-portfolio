---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../style/home.css";
---

<BaseLayout title="Home">
    <section class="hero">
        <div class="hero-inner">
            <h1 class="hero-heading">Victoria Argazova</h1>
            <p class="hero-sub">digital designer</p>
        </div>
    </section>

    <!-- SECTION 1 : WHO IS VICTORIA -->
    <section class="home-section section-layout section-who">
        <div class="title-area">
            <h2>Who is Victoria?</h2>
        </div>

        <div class="content-area">
            <p>
                I'm a digital design student passionate about blending
                storytelling, interaction, and visual design into memorable
                experiences.
            </p>
        </div>
    </section>

    <!-- SECTION 2 : SELECTED WORK -->
    <section class="home-section section-layout section-work">
        <div class="title-area">
            <h2>Selected Work</h2>
        </div>

        <div class="content-area">
            <a href="/projects/project-2">
                <div class="work-card">
                    <img
                        src="/images/bulbthumbnail.png"
                        alt="Rooted Bulb project thumbnail"
                    />

                    <h3 class="work-title">Rooted Bulb</h3>
                    <p class="work-subtitle">Interactive web experience</p>
                </div>
            </a>
        </div>
    </section>

    <!-- SECTION 3 : LET'S CONNECT -->
    <section class="home-section section-layout section-connect">
        <div class="title-area">
            <h2>Let's Connect</h2>
        </div>

        <div class="content-area">
            <div class="content-items">
                <p>
                    Want to collaborate or chat about design?
                    <a
                        class="primary-button"
                        href="mailto:v.argazova@email.com"
                    >
                        Email me →
                    </a>
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
