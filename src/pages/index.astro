---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../style/home.css";
---

<BaseLayout title="Home">
    <section class="hero">
        <div class="hero-inner">
            <h1 class="hero-heading">
                <span class="first-letter">V</span>ictoria Argazova
            </h1>
            <p class="hero-sub">Digital Designer</p>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section-inner">
            <h2 class="section-title">Who is Victoria?</h2>
            <div class="section-content">
                <p class="section-text">
                    I'm a digital design student interested in bold, graphic
                    interfaces that feel more like experiences than "just
                    websites".
                </p>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section-inner">
            <h2 class="section-title">Selected Work</h2>
            <div class="section-content">
                <a href="projects/project-2" class="work-card">
                    <div class="work-card-thumb">
                        <img
                            src="images/bulbthumbnail.png"
                            alt="Rooted Bulb thumbnail"
                        />
                    </div>
                    <h3 class="work-title">Rooted Bulb</h3>
                    <p class="work-subtitle">Interactive web experience</p>
                </a>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="home-section-inner">
            <h2 class="section-title">Let's connect</h2>
            <div class="section-content">
                <p class="section-text">
                    Want to collaborate or talk about design, interfaces or
                    weird websites?
                </p>
                <a class="primary-button" href="mailto:v.argazova@email.com">
                    Email me →
                </a>
            </div>
        </div>
    </section>

    <!-- GSAP animation: all handled here -->
    <script >
        import { gsap } from "gsap";

        if (!import.meta.env.SSR) {
            gsap.from(".hero-heading", {
                opacity: 0,
                y: 40,
                duration: 1.2,
                ease: "power2.out",
            });

            gsap.from(".hero-sub", {
                opacity: 0,
                y: 20,
                duration: 1,
                delay: 0.3,
                ease: "power2.out",
            });

            gsap.from(".first-letter", {
                opacity: 0,
                scale: 0.6,
                duration: 0.8,
                delay: 0.1,
                ease: "back.out(1.7)",
            });
        }
    </script>
</BaseLayout>
