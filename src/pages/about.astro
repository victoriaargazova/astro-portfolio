---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../style/about.css";
import { getCollection } from "astro:content";

const pageTitle = "About";

const identity = {
    firstName: "Victoria",
    lastName: "Argazova",
    country: "Bulgaria",
    residenceCountry: "Belgium",
    occupation: "Digital & UX/UI Designer",
    hobbies: ["video editing", "dancing", "pop culture"],
};

const skillsCollection = await getCollection("skills");

const skillsByCategory = skillsCollection.reduce(
    (acc, skill) => {
        const category = skill.data.category ?? "Other";
        if (!acc[category]) acc[category] = [];
        acc[category].push(skill);
        return acc;
    },
    {} as Record<string, (typeof skillsCollection)[number][]>,
);
---

<BaseLayout pageTitle={pageTitle}>
    <main class="about-page">
        <header class="about-heading-block">
            <h1 class="page-heading">About</h1>
        </header>

        <section class="about-layout">
            <aside class="about-left">
                <figure class="about-portrait">
                    <img
                        src="images/hero.png"
                        alt="Portrait of Victoria Argazova"
                    />
                </figure>
            </aside>

            <section class="about-right">
                <section class="about-block about-block--overview">
                    <h2 class="about-block-title">Who am I</h2>
                    <p>
                        I’m {identity.firstName}
                        {identity.lastName}, a{" "}
                        {identity.occupation.toLowerCase()} from {
                            identity.country
                        }, currently based in {identity.residenceCountry}. I
                        care about making digital work that feels sharp,
                        cinematic, and a bit dramatic – less “template”, more
                        “this could only belong to one person”. When I’m not
                        designing, I’m usually into {
                            identity.hobbies.join(", ")
                        }, which all sneak back into my work one way or another.
                    </p>
                </section>

                <section class="about-block about-block--details">
                    <h2 class="about-block-title">My skills</h2>

                    <div class="skills-grid">
                        {
                            Object.entries(skillsByCategory).map(
                                ([category, items]) => (
                                    <section class="skills-group">
                                        <h3 class="skills-group-title">
                                            {category}
                                        </h3>
                                        <ul class="skills-list">
                                            {items.map((skill) => (
                                                <li class="skill-item">
                                                    <span class="skill-name">
                                                        {skill.data.name}
                                                    </span>
                                                    <span
                                                        class={`skill-level skill-level--${(skill.data.level ?? "").toLowerCase()}`}
                                                    >
                                                        {skill.data.level}
                                                    </span>
                                                </li>
                                            ))}
                                        </ul>
                                    </section>
                                ),
                            )
                        }
                    </div>
                </section>

                <section class="about-block about-block--current">
                    <h2 class="about-block-title">Design philosophy</h2>
                    <p>
                        I don’t see websites as static pages, I see them as
                        experiences people move through, with mood, rhythm and
                        attitude. I like using bold typography, limited color
                        and deliberate layouts to make people
                        <em> feel </em> the brand as much as they read it. I want
                        visitors to remember how a site felt, not just what it said.
                        My goal is to design interfaces that make people pause for
                        a second, notice the details, and realise that someone actually
                        cared about the experience they’re having on a screen.
                    </p>
                </section>
            </section>
        </section>
    </main>
</BaseLayout>
