---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
    <section style="padding:2rem 0; margin-bottom:2rem;">
        <h1>About Me</h1>
        <p>
            Hello! I'm <strong>Victoria Argazova</strong>, a digital design
            student originally from Bulgaria, now based in Kortrijk, Belgium. I
            am passionate about visual storytelling and building immersive
            experiences that help users engage and connect across cultures.
        </p>
    </section>
    <section style="margin:2rem 0;">
        <h2>Values & Personal Qualities</h2>
        <ul>
            <li>Open-minded & multicultural perspective</li>
            <li>Empathetic and collaborative</li>
            <li>Self-driven & resilient from my journey moving countries</li>
            <li>Focused on making design an immersive experience</li>
        </ul>
    </section>
    <section style="margin:2rem 0;">
        <h2>Skills & Tools</h2>
        <ul>
            <li>
                <strong>Web Development:</strong> JavaScript, HTML, CSS, Git
            </li>
            <li>
                <strong>Animation:</strong> GSAP (ScrollTrigger, Flip), After Effects
            </li>
            <li>
                <strong>Creative Coding:</strong> ML5.js, generative visuals
            </li>
            <li><strong>Design & Prototyping:</strong> Figma, UI animation</li>
            <li>
                <strong>Branding & UX Research:</strong> User flows, competitor analysis
            </li>
        </ul>
    </section>
    <section style="margin:2rem 0; text-align:center;">
        <h3>Contact</h3>
        <p>
            Want to chat about design, storytelling, or cross-cultural
            experiences?<br />
            <a href="mailto:your@email.com">Email me</a>
            &nbsp;or&nbsp;
            <a href="https://www.linkedin.com">Connect on LinkedIn</a>
        </p>
    </section>
</BaseLayout>
