---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About Me";

const identity = {
    firstName: "Victoria",
    country: "Bulgaria",
     residenceCountry:"Belgium",
    occupation: "student",
    hobbies: ["video editing", "dancing", "pop culture"],
};

const skills = [
    "Figma",
    "Adobe Creative Suite",
    "HTML",
    "CSS",
    "Astro",
    "JavaScript",
];

---

<BaseLayout pageTitle={pageTitle}>
    <section>
        <h2>This is my portfolio! Welcome!</h2>

        <p>Here are a few things you need to know about me:</p>
        <ul>
            <li>My name is {identity.firstName}.</li>
            <li>
                I am from {identity.country}, but I am based in {
                    identity.residenceCountry
                } I am currently a {identity.occupation}.
            </li>
            {
                identity.hobbies.length >= 2 && (
                    <li>
                        My hobbies are{identity.hobbies[0]} and{" "}
                        {identity.hobbies[1]}
                    </li>
                )
            }
        </ul>

        <p>My skills are:</p>
        <ul>
            {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>

</BaseLayout>
