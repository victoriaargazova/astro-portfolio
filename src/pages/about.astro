---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../style/about.css";

const pageTitle = "About";

const identity = {
    firstName: "Victoria",
    lastName: "Argazova",
    country: "Bulgaria",
    residenceCountry: "Belgium",
    occupation: "Digital & UX/UI Designer",
    hobbies: ["video editing", "dancing", "pop culture"],
};

const skills = [
    "Figma",
    "Adobe Creative Suite",
    "HTML",
    "CSS",
    "Astro",
    "JavaScript",
];
---

<BaseLayout pageTitle={pageTitle}>
    <main class="about-page">
        <!-- LEFT COLUMN: NAME / ROLE / OPTIONAL IMAGE -->
        <aside class="about-left">
            <p class="about-label">About</p>

            <h1 class="about-name">
                {identity.firstName}
                <span>{identity.lastName}</span>
            </h1>

            <p class="about-role">{identity.occupation}</p>

            <!-- OPTIONAL PORTRAIT: put your image here -->
            <figure class="about-portrait">
                <img
                    src="/images/victoria-portrait.jpg"
                    alt="Portrait of Victoria Argazova"
                />
            </figure>
        </aside>

        <!-- RIGHT COLUMN: COPY -->
        <section class="about-right">
            <section class="about-block">
                <h2 class="about-block-title">Overview</h2>
                <p>
                    I’m {identity.firstName}, a {
                        identity.occupation.toLowerCase()
                    } from{" "}
                    {identity.country}, currently based in {
                        identity.residenceCountry
                    }. I’m interested in building digital work that feels sharp,
                    clear, and a bit dramatic.
                </p>
                <p>
                    I like using strong typography, simple grids and bold
                    contrasts to create interfaces that are both functional and
                    visually opinionated.
                </p>
            </section>

            <section class="about-block about-block-split">
                <div>
                    <h2 class="about-block-title">Details</h2>
                    <ul class="about-details">
                        <li>
                            <span class="about-details-label">Name</span>
                            <span>{identity.firstName} {identity.lastName}</span
                            >
                        </li>
                        <li>
                            <span class="about-details-label">From</span>
                            <span>{identity.country}</span>
                        </li>
                        <li>
                            <span class="about-details-label">Based in</span>
                            <span>{identity.residenceCountry}</span>
                        </li>
                        <li>
                            <span class="about-details-label">Role</span>
                            <span>{identity.occupation}</span>
                        </li>
                        <li>
                            <span class="about-details-label">Hobbies</span>
                            <span>{identity.hobbies.join(", ")}</span>
                        </li>
                    </ul>
                </div>

                <div>
                    <h2 class="about-block-title">Skills</h2>
                    <ul class="about-skills">
                        {
                            skills.map((skill) => (
                                <li class="about-skill-pill">{skill}</li>
                            ))
                        }
                    </ul>
                </div>
            </section>

            <section class="about-block">
                <h2 class="about-block-title">Currently</h2>
                <p>
                    I’m exploring how brutalist layouts, editorial typography
                    and UX thinking can live together in dark, minimal
                    interfaces.
                </p>
                <p>
                    I’m open to collaborations, conversations, and projects that
                    push digital design into slightly stranger, more expressive
                    directions.
                </p>
            </section>
        </section>
    </main>
</BaseLayout>
