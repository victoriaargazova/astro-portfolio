---
import { getCollection, type CollectionEntry } from "astro:content";
import BlogLayout from "../layouts/BlogLayout.astro";

const blogPosts: CollectionEntry<"blog">[] = await getCollection("blog");
const sortedPosts = blogPosts.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BlogLayout pageTitle="Blog">
    <header class="blog-heading-block">
        <h1 class="page-heading">Blog</h1>
    </header>

    <section class="blog-list">
        {
            sortedPosts.map((post) => (
                <article class="blog-list-item">
                    <a class="blog-list-link" href={`blog/${post.id}`}> 
                        <div class="blog-list-meta">
                            <span class="blog-list-date">
                                {new Date(post.data.pubDate).toDateString()}
                            </span>

                            {post.data.tags && post.data.tags.length > 0 && (
                                <span class="blog-list-tags">
                                    {post.data.tags.join(" / ")}
                                </span>
                            )}
                        </div>

                        <h2 class="blog-list-title">{post.data.title}</h2>

                        {post.data.description && (
                            <p class="blog-list-desc">
                                {post.data.description}
                            </p>
                        )}
                    </a>
                </article>
            ))
        }
    </section>
</BlogLayout>
