---
import BlogArticleLayout from "../../layouts/BlogArticleLayout.astro";
import { getEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const blogPosts = await getCollection("blog");
    return blogPosts.map((post) => ({
        params: { id: post.id },
    }));
}

const { id } = Astro.params;
const entry = await getEntry("blog", id);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
---

<BlogArticleLayout pageTitle={entry.data.title}>
    <!-- PASS META DATA -->
    <Fragment slot="meta">
        <span class="meta-item">
            <span class="meta-key">By</span>
            <span class="meta-value">{entry.data.author}</span>
        </span>
        <span class="meta-item">
            <span class="meta-key">Published</span>
            <span class="meta-value">{entry.data.pubDate.toDateString()}</span>
        </span>
        {
            entry.data.tags && (
                <span class="meta-item">
                    <span class="meta-key">Tags</span>
                    <span class="meta-value">{entry.data.tags.join(", ")}</span>
                </span>
            )
        }
    </Fragment>

    <!-- PASS EXCERPT -->
    <Fragment slot="excerpt">
        {
            entry.data.description && (
                <p class="article-excerpt">{entry.data.description}</p>
            )
        }
    </Fragment>

    <!-- PASS CONTENT -->
    <Content />
</BlogArticleLayout>
