---
import GithubIcon from "./icons/github.svg";
import BehanceIcon from "./icons/behance.svg";

const socials = [
    {
        label: "GitHub",
        href: "https://github.com/victoriaargazova",
        icon: GithubIcon,
    },
    {
        label: "Behance",
        href: "https://www.behance.net/victoriargazov",
        icon: BehanceIcon,
    },
];
---

<nav class="social-links" aria-label="Social media">
    {
        socials.map((s) => (
            <a
                class="social-link"
                href={s.href}
                target="_blank"
                rel="noreferrer"
                aria-label={s.label}
            >
                <s.icon class="social-icon" />
            </a>
        ))
    }
</nav>
