---
const { title } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
    </head>
    <body
        style="font-family:Arial,sans-serif;max-width:480px;margin:0 auto;padding:1.2rem;background:#fff;"
    >
        <main>
            <slot />
        </main>
    </body>
</html>
