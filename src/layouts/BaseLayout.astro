---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import "../style/global.css";
const base = import.meta.env.BASE_URL;
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<base href={import.meta.env.BASE_URL} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Alumni+Sans:ital,wght@0,100..900;1,100..900&family=Archivo+Black&family=Imperial+Script&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
			rel="stylesheet"
		/>
		<script src="https://cdn.jsdelivr.net/npm/p5@1.9.0/lib/p5.min.js" defer
		></script>
	</head>

	<body>
		<Navigation />

		<main class="page-wrap">
			<slot />
		</main>

		<script src="js/navmenu.js" defer></script>
		<script src="js/bow.js" defer></script>
		<Footer />
	</body>
</html>
